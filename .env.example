# Copy to .env and fill in.

# Urgency SLA, in business hours
URGENT_SLA_BUSINESS_HOURS=2

# Any OpenAI-compatible endpoint (OpenRouter, Groq, Cerebras, Google AI Studio, Ollama, ...)
# e.g. https://openrouter.ai/api/v1  or  http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional tuning (defaults shown). Groq free tier: ~8000 tokens/minute, 1000 requests/day.
# LLM_BATCH_SIZE=20
# LLM_TOKENS_PER_MINUTE=7000
# LLM_MAX_WAIT_SECONDS=90          # give up (keyword fallback) if the provider asks to wait longer
# LLM_CLASSIFY_BUDGET_SECONDS=     # empty = no limit (CLI); dashboard uploads use 40 s
# LLM_DRAFT_TIMEOUT_SECONDS=20
